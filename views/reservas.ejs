<%- include('shared/header',{title:'Minhas reservas'}) %>
<section class="page-hero reveal">
  <span class="eyebrow">Minha estante</span>
  <h1>Minhas reservas</h1>
  <p>Acompanhe seus livros reservados e cancele quando precisar.</p>
</section>
<div class="table reveal">
  <table>
    <tr><th>Livro</th><th>Autor</th><th>Data</th><th>Status</th><th></th></tr>
    <% if(!reservas.length){ %><tr><td colspan="5">Você ainda não fez nenhuma reserva.</td></tr><% } %>
    <% reservas.forEach(r=>{ %>
      <tr>
        <td><strong><%= r.titulo %></strong></td>
        <td><%= r.autor %></td>
        <td><%= r.data_reserva %></td>
        <td><span class="tag <%= r.status === 'cancelada' ? 'danger' : '' %>"><%= r.status %></span></td>
        <td><% if(r.status==='pendente'){ %><form method="post" action="/reservas/<%= r.id %>/cancelar"><button class="table-action">Cancelar</button></form><% } %></td>
      </tr>
    <% }) %>
  </table>
</div>
<%- include('shared/footer') %>
